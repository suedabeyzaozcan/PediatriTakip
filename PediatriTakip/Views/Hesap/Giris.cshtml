@model GirisVM
@{ ViewData["Title"] = "Giriş"; }
<div class="giris-kutu">
    <div class="card p-4">
        <h3 class="text-center mb-1"><i class="bi bi-heart-pulse text-success"></i> Pediatri Takip</h3>
        <p class="text-center text-muted mb-4">Çocuk gelişim takip sistemi</p>
        <form asp-action="Giris" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autofocus />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Sifre" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="Sifre" class="form-control" />
                    <button type="button" class="btn btn-outline-secondary" id="sifreGoster" title="Şifreyi göster"><i class="bi bi-eye"></i></button>
                </div>
                <span asp-validation-for="Sifre" class="text-danger small"></span>
            </div>
            <button class="btn btn-pediatri w-100">Giriş Yap</button>
        </form>
        <p class="text-center mt-3 mb-0 small">Veli misiniz? <a asp-action="Kayit">Hesap oluşturun</a></p>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // DOM: şifre göster/gizle
        $("#sifreGoster").on("click", function () {
            const $s = $("#Sifre");
            const gizli = $s.attr("type") === "password";
            $s.attr("type", gizli ? "text" : "password");
            $(this).find("i").toggleClass("bi-eye bi-eye-slash");
        });
    </script>
}
