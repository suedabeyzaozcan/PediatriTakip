<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pediatri Takip</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var girisli = User.Identity?.IsAuthenticated == true;
        var c = ViewContext.RouteData.Values["controller"]?.ToString();
    }
    <nav class="navbar navbar-expand-md navbar-dark bg-pediatri mb-4">
        <div class="container">
            <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index"><i class="bi bi-heart-pulse"></i> Pediatri Takip</a>
            @if (girisli)
            {
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="menu">
                    <ul class="navbar-nav me-auto">
                        @if (User.IsInRole("Admin") || User.IsInRole("Doktor"))
                        {
                            <li class="nav-item"><a class="nav-link @(c == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Panel</a></li>
                            <li class="nav-item"><a class="nav-link @(c == "Hasta" ? "active" : "")" asp-controller="Hasta" asp-action="Index">Hastalar</a></li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link @(c == "Kullanici" ? "active" : "")" asp-controller="Kullanici" asp-action="Index">Kullanıcılar</a></li>
                        }
                        @if (User.IsInRole("Veli"))
                        {
                            <li class="nav-item"><a class="nav-link active" asp-controller="Hasta" asp-action="Cocuklarim">Çocuklarım</a></li>
                        }
                    </ul>
                    <span class="navbar-text text-white me-3">
                        <i class="bi bi-person-circle"></i> @User.Identity!.Name
                        <span class="badge bg-light text-dark ms-1">@(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Doktor") ? "Doktor" : "Veli")</span>
                    </span>
                    <form asp-controller="Hesap" asp-action="Cikis" method="post" class="d-inline">
                        <button class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right"></i> Çıkış</button>
                    </form>
                </div>
            }
        </div>
    </nav>

    <div class="container">
        @Html.AntiForgeryToken()
        @if (TempData["Mesaj"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">@TempData["Mesaj"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        <main class="pb-4">@RenderBody()</main>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3"><div id="bildirim" class="toast text-white border-0"><div class="d-flex"><div class="toast-body"></div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
