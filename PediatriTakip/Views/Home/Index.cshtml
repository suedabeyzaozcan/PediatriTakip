@model PanelVM
@using PediatriTakip.Helpers
@{ ViewData["Title"] = "Panel"; }
<h3 class="mb-4">Hoş geldiniz, @User.Identity!.Name</h3>
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6"><div class="card stat-card p-3"><div class="text-muted small">@(User.IsInRole("Admin") ? "Toplam Hasta" : "Hastalarım")</div><div class="sayi">@Model.HastaSayisi</div></div></div>
    <div class="col-md-3 col-6"><div class="card stat-card p-3"><div class="text-muted small">Bu Ay Muayene</div><div class="sayi">@Model.BuAyMuayene</div></div></div>
    @if (User.IsInRole("Admin"))
    {
        <div class="col-md-3 col-6"><div class="card stat-card p-3"><div class="text-muted small">Doktor</div><div class="sayi">@Model.DoktorSayisi</div></div></div>
        <div class="col-md-3 col-6"><div class="card stat-card p-3"><div class="text-muted small">Veli</div><div class="sayi">@Model.VeliSayisi</div></div></div>
    }
</div>
<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <strong>Son Muayeneler</strong>
        <a asp-controller="Hasta" asp-action="Ekle" class="btn btn-pediatri btn-sm"><i class="bi bi-plus"></i> Yeni Hasta</a>
    </div>
    <table class="table mb-0">
        <thead><tr><th>Tarih</th><th>Hasta</th><th>Boy</th><th>Kilo</th><th>Tanı</th></tr></thead>
        <tbody>
        @foreach (var m in Model.SonMuayeneler)
        {
            <tr>
                <td>@YasHelper.Goster(m.Tarih)</td>
                <td><a asp-controller="Hasta" asp-action="Detay" asp-route-id="@m.HastaId">@m.Hasta.AdSoyad</a></td>
                <td>@(m.BoyCm?.ToString() ?? "-") cm</td>
                <td>@(m.KiloKg?.ToString() ?? "-") kg</td>
                <td>@m.Tani</td>
            </tr>
        }
        @if (!Model.SonMuayeneler.Any())
        {
            <tr><td colspan="5" class="text-muted text-center">Henüz muayene kaydı yok.</td></tr>
        }
        </tbody>
    </table>
</div>
