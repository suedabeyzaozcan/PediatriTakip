@model List<Hastalar>
@using PediatriTakip.Helpers
@{ ViewData["Title"] = "Hastalar"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Hastalar</h3>
    <a asp-action="Ekle" class="btn btn-pediatri"><i class="bi bi-plus-lg"></i> Yeni Hasta</a>
</div>
<div class="card">
    <div class="card-body pb-0">
        <input id="arama" class="form-control" placeholder="Ad veya TC Kimlik No ile ara..." />
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>Ad Soyad</th><th>Cinsiyet</th><th>Doğum Tarihi</th><th>Yaş</th>@if (User.IsInRole("Admin")){<th>Doktor</th>}<th>Veli</th><th></th></tr></thead>
            <tbody id="hastaTablo">
            @foreach (var h in Model)
            {
                <tr data-id="@h.Id">
                    <td><a asp-action="Detay" asp-route-id="@h.Id">@h.AdSoyad</a></td>
                    <td>@h.Cinsiyet</td>
                    <td>@YasHelper.Goster(h.DogumTarihi)</td>
                    <td>@YasHelper.YasMetni(h.DogumTarihi)</td>
                    @if (User.IsInRole("Admin")) { <td>@h.Doktor.AdSoyad</td> }
                    <td>@(h.Veli?.AdSoyad ?? "—")</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Duzenle" asp-route-id="@h.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                        <button class="btn btn-sm btn-outline-danger sil" data-id="@h.Id" data-ad="@h.AdSoyad"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div id="bos" class="text-center text-muted p-3 @(Model.Any() ? "d-none" : "")">Kayıt bulunamadı.</div>
</div>

@section Scripts {
<script>
    const admin = @(User.IsInRole("Admin") ? "true" : "false");
    const detayUrl = "@Url.Action("Detay")/", duzenleUrl = "@Url.Action("Duzenle")/";
    let zamanlayici;

    // AJAX: yazdıkça sunucuda ara, tabloyu DOM ile yeniden oluştur
    $("#arama").on("input", function () {
        clearTimeout(zamanlayici);
        const q = $(this).val();
        zamanlayici = setTimeout(() => {
            $.getJSON("@Url.Action("Ara")", { q }, function (liste) {
                const $tb = $("#hastaTablo").empty();
                liste.forEach(h => {
                    $tb.append(`<tr data-id="${h.id}">
                        <td><a href="${detayUrl + h.id}">${esc(h.adSoyad)}</a></td>
                        <td>${esc(h.cinsiyet)}</td><td>${esc(h.dogum)}</td><td>${esc(h.yas)}</td>
                        ${admin ? `<td>${esc(h.doktor)}</td>` : ""}
                        <td>${esc(h.veli || "—")}</td>
                        <td class="text-end text-nowrap">
                            <a href="${duzenleUrl + h.id}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                            <button class="btn btn-sm btn-outline-danger sil" data-id="${h.id}" data-ad="${esc(h.adSoyad)}"><i class="bi bi-trash"></i></button>
                        </td></tr>`);
                });
                $("#bos").toggleClass("d-none", liste.length > 0);
            });
        }, 300);
    });

    // AJAX: sil (dinamik eklenen satırlar için event delegation)
    $("#hastaTablo").on("click", ".sil", function () {
        const id = $(this).data("id"), ad = $(this).data("ad");
        if (!confirm(ad + " ve tüm muayene/aşı kayıtları silinecek. Emin misiniz?")) return;
        $.post("@Url.Action("Sil")/" + id, function (r) {
            if (r.basarili) {
                $(`tr[data-id=${id}]`).fadeOut(300, function () { $(this).remove(); $("#bos").toggleClass("d-none", $("#hastaTablo tr").length > 0); });
                bildir("Hasta silindi.");
            } else bildir(r.mesaj, false);
        });
    });
</script>
}
