@model Hastalar
@using PediatriTakip.Helpers
@{
    ViewData["Title"] = Model.AdSoyad;
    bool duzenle = ViewBag.Duzenleyebilir;
}
<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h3 class="mb-0"><i class="bi @(Model.Cinsiyet == "Kız" ? "bi-gender-female text-danger" : "bi-gender-male text-primary")"></i> @Model.AdSoyad</h3>
        <div class="text-muted">@YasHelper.YasMetni(Model.DogumTarihi) · Doğum: @YasHelper.Goster(Model.DogumTarihi)</div>
    </div>
    @if (duzenle)
    {
        <a asp-action="Duzenle" asp-route-id="@Model.Id" class="btn btn-outline-secondary"><i class="bi bi-pencil"></i> Bilgileri Düzenle</a>
    }
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3 col-6"><div class="card p-3"><div class="small text-muted">TC Kimlik No</div>@(Model.TcKimlikNo ?? "—")</div></div>
    <div class="col-md-3 col-6"><div class="card p-3"><div class="small text-muted">Kan Grubu</div>@(Model.KanGrubu ?? "—")</div></div>
    <div class="col-md-3 col-6"><div class="card p-3"><div class="small text-muted">Doktor</div>@Model.Doktor.AdSoyad</div></div>
    <div class="col-md-3 col-6"><div class="card p-3"><div class="small text-muted">Veli</div>@(Model.Veli?.AdSoyad ?? "—")</div></div>
    @if (!string.IsNullOrEmpty(Model.Alerjiler))
    {
        <div class="col-12"><div class="alert alert-warning mb-0 py-2"><i class="bi bi-exclamation-triangle"></i> <strong>Alerjiler:</strong> @Model.Alerjiler</div></div>
    }
</div>

<ul class="nav nav-tabs" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabMuayene">Muayeneler</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabGrafik" id="grafikSekme">Gelişim Grafiği</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabAsi">Aşı Takvimi</button></li>
</ul>
<div class="tab-content card border-top-0 rounded-0 rounded-bottom p-3">
    <!-- MUAYENELER -->
    <div class="tab-pane fade show active" id="tabMuayene">
        @if (duzenle)
        {
            <button class="btn btn-pediatri btn-sm mb-3" id="muayeneAcKapa"><i class="bi bi-plus-lg"></i> Yeni Muayene</button>
            <form id="muayeneForm" class="row g-2 mb-3 p-3 bg-light rounded" style="display:none">
                <input type="hidden" name="HastaId" value="@Model.Id" />
                <div class="col-md-3"><label class="form-label small">Tarih *</label><input type="date" name="Tarih" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div>
                <div class="col-md-3"><label class="form-label small">Boy (cm)</label><input type="number" step="0.1" name="BoyCm" class="form-control form-control-sm olcum" /></div>
                <div class="col-md-3"><label class="form-label small">Kilo (kg)</label><input type="number" step="0.01" name="KiloKg" class="form-control form-control-sm olcum" /></div>
                <div class="col-md-3"><label class="form-label small">Baş Çevresi (cm)</label><input type="number" step="0.1" name="BasCevresiCm" class="form-control form-control-sm" /></div>
                <div class="col-md-6"><label class="form-label small">Tanı</label><input name="Tani" class="form-control form-control-sm" /></div>
                <div class="col-md-6"><label class="form-label small">Doktor Notu</label><input name="DoktorNotu" class="form-control form-control-sm" /></div>
                <div class="col-12 d-flex align-items-center gap-3">
                    <button class="btn btn-pediatri btn-sm">Kaydet</button>
                    <span class="small text-muted" id="vkiOnizleme"></span>
                </div>
            </form>
        }
        <div class="table-responsive">
            <table class="table table-sm">
                <thead><tr><th>Tarih</th><th>Boy</th><th>Kilo</th><th>Baş Çevresi</th><th>VKİ</th><th>Tanı</th><th>Not</th>@if (duzenle){<th></th>}</tr></thead>
                <tbody id="muayeneTablo"><tr><td colspan="8" class="text-muted">Yükleniyor...</td></tr></tbody>
            </table>
        </div>
    </div>

    <!-- GRAFİK -->
    <div class="tab-pane fade" id="tabGrafik">
        <div class="btn-group btn-group-sm mb-3" id="grafikSecim">
            <button class="btn btn-outline-secondary active" data-alan="boyCm" data-etiket="Boy (cm)">Boy</button>
            <button class="btn btn-outline-secondary" data-alan="kiloKg" data-etiket="Kilo (kg)">Kilo</button>
            <button class="btn btn-outline-secondary" data-alan="basCevresiCm" data-etiket="Baş Çevresi (cm)">Baş Çevresi</button>
            <button class="btn btn-outline-secondary" data-alan="vki" data-etiket="VKİ">VKİ</button>
        </div>
        <div style="height:340px"><canvas id="grafik"></canvas></div>
    </div>

    <!-- AŞI -->
    <div class="tab-pane fade" id="tabAsi">
        <p class="small text-muted mb-2">
            <i class="bi bi-check-circle-fill durum-yapildi"></i> Yapıldı &nbsp;
            <i class="bi bi-exclamation-circle-fill durum-gecikti"></i> Zamanı geldi/geçti &nbsp;
            <i class="bi bi-clock durum-bekliyor"></i> Henüz zamanı gelmedi
        </p>
        <table class="table table-sm">
            <thead><tr><th></th><th>Aşı</th><th>Önerilen</th><th>Uygulama Tarihi</th><th>Not</th>@if (duzenle){<th style="width:330px"></th>}</tr></thead>
            <tbody id="asiTablo"></tbody>
        </table>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
    const hastaId = @Model.Id;
    const duzenle = @(duzenle ? "true" : "false");
    const bugun = "@DateTime.Today.ToString("yyyy-MM-dd")";
    let muayeneler = [], grafik = null;

    // ---------------- MUAYENELER (AJAX) ----------------
    function muayeneleriYukle() {
        $.getJSON("@Url.Action("Liste", "Muayene")", { hastaId }, function (liste) {
            muayeneler = liste;
            const $tb = $("#muayeneTablo").empty();
            if (!liste.length) $tb.append('<tr><td colspan="8" class="text-muted">Henüz muayene kaydı yok.</td></tr>');
            [...liste].reverse().forEach(m => {
                $tb.append(`<tr data-id="${m.id}">
                    <td>${m.tarihGoster}</td>
                    <td>${m.boyCm ?? "-"}</td><td>${m.kiloKg ?? "-"}</td><td>${m.basCevresiCm ?? "-"}</td>
                    <td>${m.vki ?? "-"}</td><td>${esc(m.tani)}</td><td class="small">${esc(m.doktorNotu)}</td>
                    ${duzenle ? `<td><button class="btn btn-sm btn-link text-danger muayeneSil" data-id="${m.id}"><i class="bi bi-trash"></i></button></td>` : ""}
                </tr>`);
            });
            if (grafik) grafigiCiz();
        });
    }

    $("#muayeneAcKapa").on("click", () => $("#muayeneForm").slideToggle(200));

    // DOM: boy/kilo girilince VKİ önizlemesi
    $(".olcum").on("input", function () {
        const boy = parseFloat($("[name=BoyCm]").val()), kilo = parseFloat($("[name=KiloKg]").val());
        $("#vkiOnizleme").text(boy > 0 && kilo > 0 ? "VKİ: " + (kilo / Math.pow(boy / 100, 2)).toFixed(1) : "");
    });

    $("#muayeneForm").on("submit", function (e) {
        e.preventDefault();
        $.post("@Url.Action("Ekle", "Muayene")", $(this).serialize(), function (r) {
            if (r.basarili) {
                bildir("Muayene kaydedildi.");
                $("#muayeneForm")[0].reset(); $("[name=Tarih]").val(bugun); $("#vkiOnizleme").text("");
                $("#muayeneForm").slideUp(200);
                muayeneleriYukle();
            } else bildir(r.mesaj, false);
        });
    });

    $("#muayeneTablo").on("click", ".muayeneSil", function () {
        if (!confirm("Bu muayene kaydı silinsin mi?")) return;
        const id = $(this).data("id");
        $.post("@Url.Action("Sil", "Muayene")/" + id, function (r) {
            if (r.basarili) { bildir("Muayene silindi."); muayeneleriYukle(); } else bildir(r.mesaj, false);
        });
    });

    // ---------------- GRAFİK (Chart.js) ----------------
    function grafigiCiz() {
        const $b = $("#grafikSecim .active"), alan = $b.data("alan");
        const veri = muayeneler.filter(m => m[alan] != null);
        const ayar = {
            type: "line",
            data: {
                labels: veri.map(m => m.tarihGoster),
                datasets: [{ label: $b.data("etiket"), data: veri.map(m => m[alan]), borderColor: "#2b7a78", backgroundColor: "rgba(43,122,120,.15)", fill: true, tension: .3 }]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
        };
        if (grafik) grafik.destroy();
        grafik = new Chart($("#grafik")[0], ayar);
    }
    $("#grafikSekme").on("shown.bs.tab", grafigiCiz);
    $("#grafikSecim button").on("click", function () {
        $(this).addClass("active").siblings().removeClass("active");
        grafigiCiz();
    });

    // ---------------- AŞI TAKVİMİ (AJAX) ----------------
    function asilariYukle() {
        $.getJSON("@Url.Action("AsiTakvimi", "Muayene")", { hastaId }, function (liste) {
            const $tb = $("#asiTablo").empty();
            const ikon = { yapildi: "bi-check-circle-fill durum-yapildi", gecikti: "bi-exclamation-circle-fill durum-gecikti", bekliyor: "bi-clock durum-bekliyor" };
            liste.forEach(a => {
                let islem = "";
                if (duzenle) {
                    islem = a.durum === "yapildi"
                        ? `<button class="btn btn-sm btn-link text-danger asiSil" data-id="${a.kayitId}">Kaydı sil</button>`
                        : `<div class="input-group input-group-sm">
                               <input type="date" class="form-control asiTarih" value="${bugun}" max="${bugun}">
                               <input class="form-control asiNot" placeholder="Not">
                               <button class="btn btn-outline-success asiEkle" data-asi="${a.asiId}">Yapıldı</button>
                           </div>`;
                }
                $tb.append(`<tr>
                    <td><i class="bi ${ikon[a.durum]}"></i></td>
                    <td>${esc(a.ad)}</td>
                    <td>${a.onerilenAy === 0 ? "Doğumda" : a.onerilenAy + ". ay"}</td>
                    <td>${a.tarih ?? "—"}</td><td class="small">${esc(a.notlar)}</td>
                    ${duzenle ? `<td>${islem}</td>` : ""}
                </tr>`);
            });
        });
    }

    $("#asiTablo").on("click", ".asiEkle", function () {
        const $tr = $(this).closest("tr");
        $.post("@Url.Action("AsiEkle", "Muayene")", {
            HastaId: hastaId, AsiId: $(this).data("asi"),
            UygulamaTarihi: $tr.find(".asiTarih").val(), Notlar: $tr.find(".asiNot").val()
        }, function (r) {
            if (r.basarili) { bildir("Aşı kaydedildi."); asilariYukle(); } else bildir(r.mesaj, false);
        });
    });

    $("#asiTablo").on("click", ".asiSil", function () {
        if (!confirm("Aşı kaydı silinsin mi?")) return;
        $.post("@Url.Action("AsiSil", "Muayene")/" + $(this).data("id"), function (r) {
            if (r.basarili) { bildir("Aşı kaydı silindi."); asilariYukle(); } else bildir(r.mesaj, false);
        });
    });

    muayeneleriYukle();
    asilariYukle();
</script>
}
