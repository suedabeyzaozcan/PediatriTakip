@model KullaniciVM
@{
    bool yeni = Model.Id == 0;
    ViewData["Title"] = yeni ? "Yeni Kullanıcı" : "Kullanıcı Düzenle";
}
<h3 class="mb-3">@ViewData["Title"]</h3>
<div class="card p-4" style="max-width:600px">
    <form asp-action="@(yeni ? "Ekle" : "Duzenle")" asp-route-id="@(yeni ? null : Model.Id)" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
        <div class="mb-3">
            <label asp-for="Rol" class="form-label"></label>
            <select asp-for="Rol" class="form-select"><option>Doktor</option><option>Veli</option><option>Admin</option></select>
            <span asp-validation-for="Rol" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="AdSoyad" class="form-label"></label>
            <input asp-for="AdSoyad" class="form-control" />
            <span asp-validation-for="AdSoyad" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Telefon" class="form-label"></label>
            <input asp-for="Telefon" class="form-control" />
        </div>
        <div class="mb-3" id="uzmanlikAlan">
            <label asp-for="Uzmanlik" class="form-label"></label>
            <input asp-for="Uzmanlik" class="form-control" placeholder="Örn: Çocuk Kardiyolojisi" />
        </div>
        <div class="mb-3">
            <label asp-for="Sifre" class="form-label">@(yeni ? "Şifre" : "Yeni Şifre (boş bırakılırsa değişmez)")</label>
            <input asp-for="Sifre" class="form-control" />
            <span asp-validation-for="Sifre" class="text-danger small"></span>
        </div>
        <button class="btn btn-pediatri">Kaydet</button>
        <a asp-action="Index" class="btn btn-link">İptal</a>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // DOM: uzmanlık alanı sadece doktor rolünde görünür
        function uzmanlikGuncelle() { $("#uzmanlikAlan").toggle($("#Rol").val() === "Doktor"); }
        $("#Rol").on("change", uzmanlikGuncelle);
        uzmanlikGuncelle();
    </script>
}
